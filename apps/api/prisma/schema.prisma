generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContactStatus {
  NEW
  READ
  REPLIED
}

enum ExperienceType {
  WORK
  INTERNSHIP
  FREELANCE
  LEADERSHIP
}

enum PageSectionType {
  HERO
  SERVICES
  PROJECTS
  SKILLS
  EXPERIENCE
  EDUCATION
  TESTIMONIALS
  TECH_STACK
  BLOG
  CONTACT
  ABOUT
  ACHIEVEMENTS
}

model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String
  role         String
  refreshToken String?
  createdAt    DateTime @default(now())
}

model Service {
  id             String   @id @default(uuid())
  title          String
  slug           String   @unique
  description    String
  content        String   @db.Text
  isPublished    Boolean  @default(false)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tags           Tag[]    @relation("ServiceToTag")
}

model Project {
  id                    String   @id @default(uuid())
  title                 String
  slug                  String   @unique
  summary               String
  content               String   @db.Text
  coverImageUrl         String?
  demoUrl               String?
  githubUrl             String?
  role                  String?
  clientName            String?
  duration              String?
  status                String?
  industry              String?
  challenge             String?  @db.Text
  approach              String?  @db.Text
  outcome               String?  @db.Text
  metrics               String?  @db.Text
  stackSummary          String?
  gallery               Json     @default("[]")
  relatedServiceSlugs   Json     @default("[]")
  featured              Boolean  @default(false)
  order                 Int      @default(0)
  isPublished           Boolean  @default(false)
  seoTitle              String?
  seoDescription        String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  tags                  Tag[]    @relation("ProjectToTag")
}

model Profile {
  id             String   @id @default(uuid())
  name           String
  shortName      String?
  title          String
  bio            String   @db.Text
  headline       String
  avatarUrl      String?
  resumeUrl      String?
  email          String
  alternateEmail String?
  phone          String?
  location       String?
  websiteUrl     String?
  githubUrl      String?
  linkedinUrl    String?
  twitterUrl     String?
  instagramUrl   String?
  whatsappUrl    String?
  currentCompany String?
  currentRole    String?
  alumniOf       String?
  socialLinks    Json     @default("{}")
  isPublished    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Skill {
  id          String   @id @default(uuid())
  name        String
  category    String
  proficiency Int      @default(0)
  iconUrl     String?
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Experience {
  id             String         @id @default(uuid())
  company        String
  role           String
  description    String         @db.Text
  startDate      DateTime
  endDate        DateTime?
  isPresent      Boolean        @default(false)
  logoUrl        String?
  experienceType ExperienceType @default(WORK)
  order          Int            @default(0)
  isPublished    Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Education {
  id          String    @id @default(uuid())
  institution String
  degree      String
  field       String
  startDate   DateTime
  endDate     DateTime?
  logoUrl     String?
  order       Int       @default(0)
  isPublished Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Testimonial {
  id          String   @id @default(uuid())
  name        String
  role        String
  company     String
  avatarUrl   String?
  content     String   @db.Text
  rating      Int      @default(5)
  order       Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Tag {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  createdAt DateTime   @default(now())
  blogPosts BlogPost[] @relation("BlogPostToTag")
  projects  Project[]  @relation("ProjectToTag")
  services  Service[]  @relation("ServiceToTag")
}

model BlogPost {
  id             String    @id @default(uuid())
  title          String
  slug           String    @unique
  summary        String
  content        String    @db.Text
  coverImageUrl  String?
  coverImageAlt  String?
  readTime       Int       @default(0)
  category       String?
  series         String?
  canonicalUrl   String?
  featured       Boolean   @default(false)
  order          Int       @default(0)
  isPublished    Boolean   @default(false)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  tags           Tag[]     @relation("BlogPostToTag")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Certification {
  id           String   @id @default(uuid())
  name         String
  issuer       String
  credentialId String?
  issueDate    DateTime?
  expiryDate   DateTime?
  url          String?
  description  String?  @db.Text
  order        Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Talk {
  id          String   @id @default(uuid())
  title       String
  eventName   String
  eventDate   DateTime?
  location    String?
  url         String?
  description String?  @db.Text
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContactInquiry {
  id        String        @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String        @db.Text
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model TechStack {
  id          String   @id @default(uuid())
  name        String
  iconUrl     String?
  category    String
  url         String?
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PageSection {
  id        String          @id @default(uuid())
  type      PageSectionType @unique
  label     String
  isEnabled Boolean         @default(true)
  order     Int             @default(0)
  updatedAt DateTime        @updatedAt
}

model Award {
  id          String   @id @default(uuid())
  title       String
  issuer      String
  description String?
  year        Int
  iconUrl     String?
  url         String?
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Media {
  id         String   @id @default(uuid())
  url        String
  publicId   String   @unique
  filename   String
  mimeType   String
  size       Int
  uploadedAt DateTime @default(now())
}
